<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Career Opportunities</title>
  <link rel="stylesheet" href="/css/styles.css"/>
  <style>
    /* CARD STYLES */
    .event-card {
      display: flex;
      gap: 20px;
      padding: 20px;
      margin-bottom: 20px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
      align-items: center;
    }

    .event-image img {
      width: 180px;
      height: 130px;
      object-fit: cover;
      border-radius: 10px;
    }

    .event-info {
      flex: 1;
    }

    .event-info h3 {
      margin: 0 0 10px 0;
    }

    .event-info p {
      margin: 4px 0;
      color: #555;
      font-size: 0.9rem;
    }

    .event-badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 0.7rem;
      font-weight: bold;
      margin-bottom: 8px;
    }

    .badge-workshop {
      background: #e3f2fd;
      color: #1976d2;
    }

    .badge-job {
      background: #e8f5e9;
      color: #388e3c;
    }

    .badge-saved {
      background: #fff3e0;
      color: #f57c00;
    }

    .view-btn {
      padding: 10px 16px;
      background-color: #4CAF50;
      color: white;
      text-decoration: none;
      border-radius: 6px;
      display: inline-block;
      font-size: 0.85rem;
    }

    .view-btn:hover {
      background-color: #45a049;
    }

    /* Section title */
    .section-title {
      font-size: 1.4rem;
      margin: 25px 0 15px 0;
      color: #333;
      border-left: 4px solid #4CAF50;
      padding-left: 15px;
    }

    hr {
      margin: 20px 0;
      border: none;
      border-top: 1px solid #e0e0e0;
    }

    /* Admin table */
    .admin-section {
      background: white;
      border-radius: 12px;
      padding: 20px;
      margin-top: 30px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }

    .admin-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    .admin-table th,
    .admin-table td {
      padding: 10px;
      text-align: left;
      border-bottom: 1px solid #eee;
    }

    .admin-table th {
      background: #f8f9fa;
      font-weight: 600;
    }

    .admin-actions form {
      display: inline;
      margin-right: 5px;
    }

    .admin-actions input,
    .admin-actions button {
      padding: 5px 12px;
      border-radius: 4px;
      border: 1px solid #ddd;
      background: white;
      cursor: pointer;
    }

    .admin-actions button:hover {
      background: #dc3545;
      color: white;
      border-color: #dc3545;
    }

    .empty-state {
      text-align: center;
      padding: 40px;
      background: white;
      border-radius: 12px;
      color: #888;
    }

    @media (max-width: 768px) {
      .container {
        width: 90%;
      }
      .event-card {
        flex-direction: column;
        align-items: flex-start;
      }
      .event-image img {
        width: 100%;
        height: 200px;
      }
      .filter-grid {
        flex-direction: column;
      }
      .filter-actions {
        flex-direction: row;
      }
    }
  </style>
</head>
<body>
  <% if (typeof msg !== 'undefined' && msg) { %>
    <div id="toast"><%= msg %></div>
  <% } %>
  
  <%- include('../navbar') %>

  <div class="container">
   
    <!-- filterbar  -->

  <div class="filter-section">
    <h3 style="margin-top:0; margin-bottom:15px;">Filter Events</h3>
    <form action="/career-events" method="GET">
      
      <!-- Sectors - top row -->
      <div style="margin-bottom:15px;">
        <span style="font-weight:bold; margin-right:10px;">Sector:</span>
        <% sectors.forEach(s => { %>
          <label style="margin-right:12px; white-space:nowrap;">
            <input type="checkbox" name="selectedSectors" value="<%= s %>"
              <%= selectedSectors && selectedSectors.includes(s) ? 'checked' : '' %>/>
            <%= s %>
          </label>
        <% }) %>
      </div>

    <!-- 2nd row filters  -->
    <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end;">
      <input type="text" name="q" placeholder="Search..." value="<%= q || '' %>" style="padding:6px; width:150px;">
      
      <select name="careerType" style="padding:6px;">
        <option value="">All types</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>" <%= careerType === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
      
      <input type="date" name="dateFrom" value="<%= dateFrom || '' %>" style="padding:6px; width:130px;">
      <input type="date" name="dateTo" value="<%= dateTo || '' %>" style="padding:6px; width:130px;">
      
      <input type="hidden" name="filtered" value="True">
      <input type="submit" value="Search" style="padding:6px 12px;">
      <a href="/career-events" style="padding:6px 12px;">Clear</a>
    </div>
  </form>
  </div>

    <!-- rsvpconfirm and waitlist -->
    <h2 class="section-title"> RSVP Career Events</h2>
    <% if (pinned && pinned.length > 0) { %>
      <% pinned.forEach(event => { %>
        <div class="event-card">
          <div class="event-image">
            <img src="/images/<%= event.image || 'default_cover.jpg' %>" 
                 alt="<%= event.title %>"
                 onerror="this.onerror=null; this.src='/images/default_cover.jpg';">
          </div>
          <div class="event-info">
            <span class="event-badge badge-saved">[<%= rsvps.find(r => r.event.toString() === event.eventId.toString()).status %>]</span>
            <h3><%= event.title %></h3>
            <p><b>Organizer:</b> <%= event.organizer %></p>
            <p><b>Date:</b> <%= new Date(event.startDate).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            <% if (event.location) { %>
              <p><b>Location:</b> <%= event.location %></p>
            <% } %>
          </div>
          <div>
            <a class="view-btn" href="/career-events/<%= event.eventId %>">View Details</a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">No saved events yet.</div>
    <% } %>

    <!-- career readiness workshops -->
    <h2 class="section-title">Workshops & Coaching</h2>
    <% if (workshops && workshops.length > 0) { %>
      <% workshops.forEach(event => { %>
        <div class="event-card">
          <div class="event-image">
            <img src="/images/<%= event.image || 'default_cover.jpg' %>" 
                 alt="<%= event.title %>"
                 onerror="this.onerror=null; this.src='/images/default_cover.jpg';">
          </div>
          <div class="event-info">
            <span class="event-badge badge-workshop">[Workshop]</span>
            <h3><%= event.title %></h3>
            <p><b>Organizer:</b> <%= event.organizer %></p>
            <p><b>Date:</b> <%= new Date(event.startDate).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            <p><b>Location:</b> <%= event.location || '—' %></p>
          </div>
          <div>
            <a class="view-btn" href="/career-events/<%= event.eventId %>">View Details</a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">No workshops found.</div>
    <% } %>

    <!-- out of campus work -->
    <h2 class="section-title">Jobs & Internships</h2>
    <% if (jobs && jobs.length > 0) { %>
      <% jobs.forEach(event => { %>
        <div class="event-card">
          <div class="event-image">
            <img src="/images/<%= event.image || 'default_cover.jpg' %>" 
                 alt="<%= event.title %>"
                 onerror="this.onerror=null; this.src='/images/default_cover.jpg';">
          </div>
          <div class="event-info">
            <span class="event-badge badge-job">[<%= event.careerType || 'Job' %>]</span>
            <h3><%= event.title %></h3>
            <p><b>Organizer:</b> <%= event.organizer %></p>
            <p><b>Date:</b> <%= new Date(event.startDate).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            <p><b>Sector:</b> <%= event.sector || '—' %></p>
            <% if (event.salary) { %>
              <p><b>Salary:</b> $<%= event.salary %>/month</p>
            <% } %>
            <% if (event.deadline) { %>
              <p><b>Deadline:</b> <%= new Date(event.deadline).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'short', year: 'numeric' }) %></p>
            <% } %>
          </div>
          <div>
            <a class="view-btn" href="/career-events/<%= event.eventId %>">View Details</a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">No jobs found.</div>
    <% } %>

    <!-- admin auth u cant bypass by changing route-->
    <% if (user && user.role !== 'student') { %> 
      <div class="admin-section">
        <h3 style="margin-top: 0;">Admin</h3><br>
        <form method="get" action="/career-events/form?id=" style="margin-bottom: 20px;">
          <input type="submit" class="btn btn-primary" value="+ Create New Career Event"> 
        </form>

        <%
          const allEvents = [...(jobs || []), ...(workshops || [])];
        %>
        <% if (allEvents.length > 0) { %>
          <div style="overflow-x: auto;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Organizer</th>
                  <th>Type</th>
                  <th>Sector</th>
                  <th>Start Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% allEvents.forEach(event => { %>
                  <tr>
                    <td><%= event.title %></td>
                    <td><%= event.organizer %></td>
                    <td><%= event.careerType || '—' %></td>
                    <td><%= event.sector || '—' %></td>
                    <td><%= new Date(event.startDate).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                    <td class="admin-actions">
                      <form method="GET" action="/career-events/form" style="display:inline">
                        <input type="hidden" name="id" value="<%= event._id %>"/>
                        <input type="submit" value="Edit"/>
                      </form>
                      <form method="POST" action="/career-events/career-delete" style="display:inline">
                        <input type="hidden" name="careerID" value="<%= event._id %>"/>
                        <button type="submit" onclick="return confirm('Delete this event?')">Delete</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <script>
    const toast = document.getElementById('toast');
    if (toast) setTimeout(() => toast.remove(), 3000);
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Scheduling Conflict</title>
  <link rel="stylesheet" href="/css/styles.css"/>
  <style>
    .conflict-container {
      width: 70%;
      margin: 30px auto;
    }
    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
      margin-top: 20px;
    }
    .detail-row {
      margin-bottom: 10px;
      color: #555;
    }
    .btn {
      padding: 10px 16px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      font-size: 14px;
      font-family: Arial, sans-serif;
    }
    .btn-primary {
      background-color: #4CAF50;
      color: white;
    }
    .btn-secondary {
      background-color: #6c757d;
      color: white;
    }
    .event-block {
      background: #f8f9fa;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 15px;
    }
    hr {
      margin: 20px 0;
      border: none;
      border-top: 1px solid #eee;
    }
  </style>
</head>
<body>
  <%- include('../navbar') %>

  <div class="conflict-container">

    <div class="card">
      <h2 style="margin-top:0;">Scheduling Conflict</h2>

      <p>You already have a confirmed event during this time:</p>

      <div class="event-block">
        <div class="detail-row"><strong>Existing</strong></div>
        <div class="detail-row"><%= conflictingEvent.title %></div>
        <div class="detail-row">
          <%= new Date(conflictingEvent.startDate).toLocaleString('en-SG', { timeZone: 'Asia/Singapore', weekday: 'short', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) %>
          to
          <%= new Date(conflictingEvent.endDate).toLocaleString('en-SG', { timeZone: 'Asia/Singapore', weekday: 'short', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) %>
        </div>
      </div>

      <div class="event-block">
        <div class="detail-row"><strong>New</strong></div>
        <div class="detail-row"><%= newEvent.title %></div>
        <div class="detail-row">
          <%= new Date(newEvent.startDate).toLocaleString('en-SG', { timeZone: 'Asia/Singapore', weekday: 'short', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) %>
          to
          <%= new Date(newEvent.endDate).toLocaleString('en-SG', { timeZone: 'Asia/Singapore', weekday: 'short', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) %>
        </div>
      </div>

      <hr/>

      <h4>What would you like to do?</h4>

      <form method="post" action="/dashboard/rsvp-replace" style="display:inline-block; margin-right:10px;">
        <input type="hidden" name="oldRsvpId"  value="<%= conflictRsvpId %>">
        <input type="hidden" name="oldEventId" value="<%= conflictingEvent._id %>">
        <input type="hidden" name="newEventId" value="<%= newEvent._id %>">
        <input type="hidden" name="response" value="replace">
        <button type="submit" class="btn btn-primary">
          Drop "<%= conflictingEvent.title %>" and join "<%= newEvent.title %>"
        </button>
      </form>

      <form method="post" action="/dashboard/rsvp-replace" style="display:inline-block;">
        <input type="hidden" name="oldRsvpId"  value="<%= conflictRsvpId %>">
        <input type="hidden" name="oldEventId" value="<%= conflictingEvent._id %>">
        <input type="hidden" name="newEventId" value="<%= newEvent._id %>">
        <input type="hidden" name="response" value="keep">
        <input type="submit" class="btn btn-secondary" value='Keep "<%= conflictingEvent.title %>"'>
      </form>
    </div>
  </div>

</body>
</html>
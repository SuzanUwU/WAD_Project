<!DOCTYPE html>
<html>
<head>
  <title>Create Admin</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 500px; margin: 50px auto; padding: 20px; }
    .error { color: #d32f2f; background: #ffebee; padding: 12px; border-radius: 4px; margin: 10px 0; }
    input, select { width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; }
    button { width: 100%; padding: 14px; background: #ff9800; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer; }
    table { width: 100%; border-collapse: collapse; }
    td { padding: 8px 0; }
    .warning { background: #fff3cd; padding: 12px; border-radius: 4px; margin: 20px 0; }
  </style>
</head>
<body>
  <h1>🔥 Super Admin: Create New Admin</h1>
  
  <div class="warning">
    <strong>Only Super Admin can access this page</strong><br>
    Creating admin A00X with scope permissions.
  </div>

  <form method="POST" action="/superadmin/create-admin">
    <table>
      <tr><td>Username:</td></tr>
      <tr><td><input type="text" name="username" placeholder="Admin username" required></td></tr>
      
      <tr><td>Email:</td></tr>
      <tr><td><input type="email" name="email" placeholder="name.year@admin.smu.edu.sg" required></td></tr>
      
      <tr><td>Password:</td></tr>
      <tr><td><input type="password" name="password" placeholder="Secure password" required minlength="6"></td></tr>
      
      <tr><td>Scope:</td></tr>
      <tr><td>
        <select name="scope" required>
          <option value="">Select Admin Scope</option>
          <option value="cca-admin">CCA Events</option>
          <option value="hack-admin">Hackathons</option>
          <option value="ptjobs-admin">Part-time Jobs</option>
          <option value="career-admin">Career Events</option>
        </select>
      </td></tr>
      
      <tr>
        <td colspan="2">
          <button type="submit">Create Admin</button>
        </td>
      </tr>
    </table>
  </form>
  
  <p><a href="/all-events">← Back to Events</a></p>
</body>
</html>

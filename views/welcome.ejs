<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SMU Events Management System</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <% include('navbar.ejs') %>

  <main class="main welcome-page">
    <h2 class="welcome-title">Welcome to</h2>
    <h1 class="welcome-title">SMU Events Management System</h1>
    <p class="welcome-subtitle">WAD Project by Group 1</p>
    <p class="welcome-text">
      You can browse, save, and manage campus events in one place!
    </p>

    <% if (user) { %>
      <p class="welcome-user-info">
        You are logged in as <strong><%= user.username %></strong> (<%= user.userId %>).
      </p>
      <a href="/all-events" class="btn btn-other">Go to Events</a>
      <a href="/logout" class="btn btn-login">Logout</a>
    <% } else { %>
      <div class="welcome-actions">
        <span>Already have an account?</span>
        <a href="/login" class="btn btn-login">Login</a>
      </div>
      <div class="welcome-actions">
        <span>New here?</span>
        <a href="/signup" class="btn btn-other">Sign Up</a>
      </div>
    <% } %>
  </main>
</body>
</html>
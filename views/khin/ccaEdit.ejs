<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Edit CCA Event</title>

<style>
body {
    font-family: Arial, sans-serif;
    background-color: #f5f6fa;
    margin: 0;
}

.container {
    width: 60%;
    margin: 30px auto;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
}

.event-image {
    text-align: center;
    margin-bottom: 15px;
}

.event-image img {
    width: 250px;
    height: 180px;
    object-fit: cover;
    border-radius: 10px;
}

.form-group {
    margin-bottom: 15px;
}

label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

input, textarea, select {
    width: 100%;
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #ccc;
}

.error {
    color: red;
    font-size: 13px;
    margin-top: 5px;
}

.error-box {
    background: #ffe0e0;
    color: #a00;
    padding: 10px;
    border-radius: 6px;
    margin-bottom: 15px;
}

.btn {
    padding: 10px 16px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
}

.btn-primary {
    background-color: #4CAF50;
    color: white;
}
</style>

</head>

<body>

<%- include('../navbar', { user: user }) %>

<div class="container">
<div class="card">

<!-- GLOBAL ERROR BOX -->
<% if (errors && Object.keys(errors).length > 0) { %>
  <div class="error-box">
    Please fix the errors below.
  </div>
<% } %>

<form action="/cca-events/ccaAdmin/<%= cca._id %>/edit" method="POST">

<!-- IMAGE -->
<div class="event-image">
    <img 
        src="/images/<%= cca.image || 'placeholder.jpg' %>" 
        onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
    >
</div>

<div class="form-group">
    <label>Image</label>
    <input type="text" name="image" value="<%= cca.image || '' %>">
</div>

<!-- TITLE -->
<div class="form-group">
    <label>Title</label>
    <input name="title" value="<%= cca.title %>">
    <% if (errors && errors.title) { %>
        <div class="error"><%= errors.title %></div>
    <% } %>
</div>

<!-- ORGANIZER -->
<div class="form-group">
    <label>Organizer</label>
    <input name="organizer" value="<%= cca.organizer %>">
    <% if (errors && errors.organizer) { %>
        <div class="error"><%= errors.organizer %></div>
    <% } %>
</div>

<!-- START DATE -->
<div class="form-group">
    <label>Start Date</label>
    <input 
        type="date" 
        name="startDate" 
        value="<%= event.startDate ? new Date(event.startDate).toISOString().split('T')[0] : '' %>"
    >
    <% if (errors && errors.startDate) { %>
        <div class="error"><%= errors.startDate %></div>
    <% } %>
</div>

<!-- END DATE -->
<div class="form-group">
    <label>End Date</label>
    <input 
        type="date" 
        name="endDate" 
        value="<%= event.endDate ? new Date(event.endDate).toISOString().split('T')[0] : '' %>"
    >
    <% if (errors && errors.endDate) { %>
        <div class="error"><%= errors.endDate %></div>
    <% } %>
</div>

<!-- LOCATION -->
<div class="form-group">
    <label>Location</label>
    <input name="location" value="<%= cca.location %>">
</div>

<!-- CLUB TYPE -->
<div class="form-group">
    <label>Club Type</label>
    <select name="clubType">
        <option value="">-- Select Club Type --</option>
        <option value="Sports" <%= cca.clubType === "Sports" ? "selected" : "" %>>Sports</option>
        <option value="Arts" <%= cca.clubType === "Arts" ? "selected" : "" %>>Arts</option>
        <option value="Academic" <%= cca.clubType === "Academic" ? "selected" : "" %>>Academic</option>
        <option value="Community" <%= cca.clubType === "Community" ? "selected" : "" %>>Community</option>
        <option value="Leadership" <%= cca.clubType === "Leadership" ? "selected" : "" %>>Leadership</option>
    </select>
    <% if (errors && errors.clubType) { %>
        <div class="error"><%= errors.clubType %></div>
    <% } %>
</div>

<!-- CAPACITY -->
<div class="form-group">
    <label>Capacity</label>
    <input type="number" name="capacity" value="<%= cca.capacity %>" min="1">
    <% if (errors && errors.capacity) { %>
        <div class="error"><%= errors.capacity %></div>
    <% } %>
</div>

<!-- DESCRIPTION -->
<div class="form-group">
    <label>Description</label>
    <textarea name="description"><%= cca.description %></textarea>
</div>

<button type="submit" class="btn btn-primary">
    Update Event
</button>

</form>

<br>
<a href="/cca-events/ccaAdmin">← Back to Admin Events</a>

</div>
</div>

</body>
</html>
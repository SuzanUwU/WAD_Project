<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Admin Edit Event</title>
</head>

<body>

<h1>Edit Event</h1>

<form action="/events/ccaAdmin/<%= event._id %>/edit" method="POST" enctype="multipart/form-data">

Title:
<input name="title" value="<%= event.title %>">

<br><br>

Current Image:<br>

<% if (event.image && event.image.data) { %>
    <img 
        src="data:<%= event.image.contentType %>;base64,<%= event.image.data.toString('base64') %>" 
        width="200"
    >
<% } else { %>
    <img src="/images/default.png" width="200">
<% } %>

<br><br>

Change Image:
<input type="file" name="image">

<br><br>

Date:
<input type="date" name="date" value="<%= event.date %>">

<br><br>

Location:
<input name="location" value="<%= event.location %>">

<br><br>

Category:
<input name="category" value="<%= event.category %>">

<br><br>

Club Type:
<input name="clubType" value="<%= event.clubType %>">

<br><br>

Description:
<textarea name="description"><%= event.description %></textarea>

<br><br>

<button type="submit">Update</button>

</form>

</body>
</html>
<!DOCTYPE html>
<html>
<head>
<title>Event Details</title>
</head>

<body>

<table width="100%">
<tr>
<td width="80">
<img src="/images/smu.webp" width="70">
</td>

<td>
<h1>SMU Event Details</h1>
</td>
</tr>
</table>

<br>

<table border="1" cellpadding="10" width="500">

<tr>
<td colspan="2" align="center">

<!-- IMAGE -->
<% if (event.image && event.image.data) { %>
    <img 
        src="data:<%= event.image.contentType %>;base64,<%= event.image.data.toString('base64') %>" 
        width="400"
    >
<% } else { %>
    <img src="/images/default.png" width="400">
<% } %>

<h2><%= event.title %></h2>

</td>
</tr>

<tr>
<td><b>Category</b></td>
<td><%= event.category %></td>
</tr>

<tr>
<td><b>Club Type</b></td>
<td><%= event.clubType %></td>
</tr>

<tr>
<td><b>Date</b></td>
<td><%= event.date %></td>
</tr>

<tr>
<td><b>Location</b></td>
<td><%= event.location %></td>
</tr>

<tr>
<td valign="top"><b>Description</b></td>
<td><%= event.description %></td>
</tr>

</table>

<br>

<%
  const today = new Date().toISOString().split("T")[0];
  const eventDate = new Date(event.date).toISOString().split("T")[0];
%>

<!-- REGISTRATION SECTION -->

<% if (eventDate < today) { %>

  <p><b>This event has ended. Registration is closed.</b></p>

<% } else if (registered) { %>

  <p><b>You have already registered for this event.</b></p>

  <a href="/events/my-events">
    <button>View My Registered Events</button>
  </a>

<% } else { %>

  <form action="/events/<%= event._id %>/register" method="GET">
      <input type="hidden" name="studentId" value="12345">
      <button type="submit">Register for Event</button>
  </form>

<% } %>

<!-- REVIEWS SECTION -->

<hr>

<h3>Reviews</h3>

<% if (!reviews || reviews.length === 0) { %>
  <p>No reviews yet</p>
<% } %>

<% reviews.forEach(r => { %>

<table border="1" cellpadding="10" width="500" style="margin-bottom:15px;">
<tr>
<td>

<table width="100%">
<tr>
<td><b><%= r.name %></b></td>
<td align="right">Rating: <%= r.rating %>/5</td>
</tr>
</table>

<hr>

<p><%= r.comment %></p>

</td>
</tr>
</table>

<% }) %>

<!-- REVIEW BUTTON -->

<% if (eventDate < today ) { %>

<a href="/events/<%= event._id %>/review?studentId=<%= studentId %>">
    <button>Write a Review</button>
</a>

<% } else { %>

<p>Reviews will be available after event ends</p>

<% } %>

</body>
</html>
<!DOCTYPE html>
<html>
<head>
  <title>Create Event</title>
</head>
<body>
  <h1>Create New Event</h1>
  
  <form method="POST" action="/events" enctype="multipart/form-data">
    <p>
      <label>Event Title:</label><br>
      <input type="text" name="title" required style="width: 300px;">
    </p>

    <p>
        <label>Organizer:</label><br>
        <input type="text" name="organizer" style="width: 300px;">
    </p>
    
    <p>
      <label>Category:</label><br>
      <select name="category" required>
        <option value="CCA">CCA</option>
        <option value="Hackathon">Hackathon</option>
        <option value="Career">Career</option>
        <option value="Part Time Jobs">Part Time Jobs</option>
      </select>
    </p>
    
    <p>
      <label>Date:</label><br>
      <input type="date" name="date" required>
    </p>
    
    <p>
      <label>Location:</label><br>
      <input type="text" name="location" style="width: 300px;">
    </p>
    
    <p>
      <label>Description:</label><br>
      <textarea name="description" rows="4" cols="50"></textarea>
    </p>
    
    <p>
      <label>Event Image (optional):</label><br>
      <input type="file" name="eventImage" accept="image/*">
    </p>
    
    <p>
      <input type="submit" value="Create Event">
      <a href="/events">Cancel</a>
    </p>
  </form>
</body>
</html>

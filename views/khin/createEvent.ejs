<!DOCTYPE html>
<html>
<head>
<title>Create Event</title>
</head>

<body>

<table>
<tr>
<td width="80">
<img src="/images/smu.webp" width="70">
</td>
<td>
<h1>Create Event</h1>
</td>
</tr>
</table>

<form action="/events/ccaAdmin/create" method="POST" enctype="multipart/form-data">

<table cellpadding="8" width="500">

<tr>
<td><b>Title</b></td>
<td>
<input type="text" name="title" size="30" required>
</td>
</tr>

<tr>
<td><b>Organizer</b></td>
<td>
<input type="text" name="organizer" size="30" required>
</td>
</tr>

<tr>
<td><b>Club Image</b></td>
<td>
<input type="file" name="image" accept="image/*" required>
</td>
</tr>

<tr>
<td><b>Date</b></td>
<td>
<input type="date" name="date" required>
</td>
</tr>

<tr>
<td><b>Location</b></td>
<td>
<input type="text" name="location" size="30" required>
</td>
</tr>

<tr>
<td><b>Category</b></td>
<td>
<input type="text" name="category" size="30" required>
</td>
</tr>

<tr>
<td><b>Club Type</b></td>
<td>
<input type="text" name="clubType" size="30" required>
</td>
</tr>

<tr>
<td valign="top"><b>Description</b></td>
<td>
<textarea name="description" rows="4" cols="32" required></textarea>
</td>
</tr>

<tr>
<td></td>
<td>
<button type="submit">Create Event</button>
</td>
</tr>

</table>

</form>

<br>

<a href="/events/ccaAdmin">Back to Admin Events</a>

</body>
</html>
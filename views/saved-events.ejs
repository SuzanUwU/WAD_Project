<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Saved Events</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('./navbar') %>

  <main class="main saved-events-page">
    <div class="header" style="padding-bottom: 10px">
      <h1><%= username %>'s Saved Events</h1>
      <a href="/all-events">← Back to All Events</a>
    </div>

    <% if (locals.error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <div class="event-grid">
      <% if (events && events.length > 0) { %>
        <% events.forEach(function(event) { %>
          <div class="card event-card">
            <% if (event.image) { %>
              <img
                class="event-image"
                src="data:<%= event.image%>"
                alt="<%= event.title %>"
              >
            <% } else { %>
              <div class="event-image">No Image Available</div>
            <% } %>

            <div class="event-info">
              <h3 class="event-title"><%= event.title %></h3>
              <p class="event-detail"><strong>Date:</strong> <%= event.date ? new Date(event.date).toLocaleDateString('en-GB') : 'TBD' %></p>
              <p class="event-detail"><strong>Location:</strong> <%= event.location || 'TBD' %></p>
              <p class="event-detail"><strong>Organizer:</strong> <%= event.organizer || 'Campus Events Team' %></p>

              <div class="event-actions">
                <a href="/events/<%= event._id %>" class="btn btn-other">View Event Details</a>
                <button class="btn btn-danger" onclick="removeSavedEvent('<%= event._id %>', this)">
                    🗑️ Remove from List
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state" style="grid-column: 1 / -1;">
          <h2>Your list is looking a little empty!</h2>
          <p>You haven't saved any events yet, or the events you saved have been deleted by the organizer.</p>
          <br>
          <a href="/all-events" class="btn btn-other">Go find some events to attend!</a>
        </div>
      <% } %>
    </div>
  </main>

  <script>
    async function removeSavedEvent(eventId, buttonElement) {
      if (!confirm("Are you sure you want to remove this event from your saved list?")) {
        return;
      }

      try {
        const originalText = buttonElement.textContent;
        buttonElement.textContent = 'Removing...';
        buttonElement.disabled = true;

        const response = await fetch(`/all-events/unsave-event/${eventId}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          const card = buttonElement.closest('.card');
          card.style.transition = "opacity 0.3s ease";
          card.style.opacity = '0';
          setTimeout(() => {
            card.remove();
            if (document.querySelectorAll('.event-card').length === 0) {
              window.location.reload();
            }
          }, 300);
        } else {
          const result = await response.json();
          alert('Could not remove: ' + result.error);
          buttonElement.textContent = originalText;
          buttonElement.disabled = false;
        }
      } catch (err) {
        console.error('Remove Error:', err);
        alert('Failed to connect to the server.');
        buttonElement.textContent = '🗑️ Remove from List';
        buttonElement.disabled = false;
      }
    }
  </script>
</body>
</html>
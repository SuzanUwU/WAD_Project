<!DOCTYPE html>
<html>
<head>
<title>Write Review</title>
</head>

<body>

<table width="100%">

<tr>
<td width="80">
<img src="/images/smu.webp" width="70">
</td>

<td>
<h2>Write a Review</h2>
</td>
</tr>

</table>

<br>

<form action="/events/<%= eventId %>/review" method="POST">

<input type="hidden" name="studentId" value="<%= studentId %>">
<input type="hidden" name="rating" id="ratingValue" required>

<table border="1" cellpadding="10" width="500">

<tr>
<td>Name</td>
<td><input type="text" name="name" required></td>
</tr>

<tr>
<td>Rating</td>
<td id="starContainer">

<span onclick="setRating(1)">☆</span>
<span onclick="setRating(2)">☆</span>
<span onclick="setRating(3)">☆</span>
<span onclick="setRating(4)">☆</span>
<span onclick="setRating(5)">☆</span>

<br><br>
<b id="ratingText"></b>

</td>
</tr>

<tr>
<td valign="top">Comment</td>
<td>
<textarea name="comment" rows="4" cols="35"></textarea>
</td>
</tr>

<tr>
<td></td>
<td>
<button type="submit">Submit Review</button>
</td>
</tr>

</table>

</form>

<br>

<a href="/events/<%= eventId %>">Back to Event</a>

<script>
function setRating(value) {
    document.getElementById("ratingValue").value = value;

    const stars = document.querySelectorAll("#starContainer span");

    stars.forEach((star, index) => {
        if (index < value) {
            star.textContent = "★";
        } else {
            star.textContent = "☆";
        }
    });

    document.getElementById("ratingText").innerText =
        "Selected: " + value + " star(s)";
}
</script>

</body>
</html>
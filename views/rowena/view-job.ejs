<!DOCTYPE html>
<html>
<head>
    <title>Part-Time Jobs</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fb;
            margin: 0;
            padding: 0;
        }

        h1 {
            text-align: center;
            margin-top: 20px;
            color: #1e3a5f;
        }

        .top-bar {
            width: 90%;
            margin: 20px auto;
            display: flex;
            justify-content: space-between;
        }

        input[type="text"] {
            width: 70%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ccc;
        }

        button {
            padding: 10px 15px;
            border: none;
            background-color: #1e3a5f;
            color: white;
            border-radius: 8px;
            cursor: pointer;
        }

        button:hover {
            background-color: #2c5282;
        }

        table {
            width: 90%;
            margin: 20px auto;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
        }

        th {
            background-color: #1e3a5f;
            color: white;
            padding: 12px;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid #eee;
            text-align: center;
        }

        tr:hover {
            background-color: #f1f5ff;
        }

        a {
            text-decoration: none;
            font-weight: bold;
        }

        .edit {
            color: #2b6cb0;
        }

        .delete {
            color: #e53e3e;
        }

        .edit:hover,
        .delete:hover {
            text-decoration: underline;
        }

        .create-btn {
            display: block;
            width: 200px;
            margin: 20px auto;
            text-align: center;
            padding: 12px;
            background-color: #1e3a5f;
            color: white;
            border-radius: 10px;
            text-decoration: none;
        }

        .create-btn:hover {
            background-color: #2c5282;
        }
    </style>
</head>

<body>

    <h1>Part-Time Jobs</h1>
    <a href="/all-events">Head back to all events</a>
    <br>

    <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
        <a href="/events/part-time-jobs/create" class="create-btn">+ Create New Job</a>
        <br><br>
        <a href="/events/part-time-jobs/applicants">View Job Applicants</a>
    <% } %>

    <% if (user.role==='student') { %>
        <a href="/events/part-time-jobs/applied-job">View Applied Jobs</a>
        <a href="/events/part-time-jobs/active-jobs">View Active Jobs</a>
    <% } %>

    <table>
        <tr>
            <th>Logo</th>
            <th>Company</th>
            <th>Job Title</th>
            <th>Job Description</th>
            <th>Salary</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Hiring Status</th>

            <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
                <th>Modification</th>
            <% } %>
        </tr>

        <% if (joblist && joblist.length > 0) { %>
            <% joblist.forEach(job => { %>
                <tr>
                    <td width="100" height="100">
                        <img src="<%= job.companylogo %>" style="width:100%; height:100%; object-fit:cover;">
                    </td>

                    <td><%= job.companyname %></td>
                    <td><%= job.jobtitle %></td>
                    <td><%= job.jobdescription %></td>
                    <td>$<%= job.salary %></td>
                    <td><%= job.startDate ? new Date(job.startDate).toLocaleDateString() : '' %></td>
                    <td><%= job.endDate ? new Date(job.endDate).toLocaleDateString() : '' %></td>

                    <td>
                        <%= new Date() > new Date(job.hiringDate) ? 'Expired' : 'Active' %>

                        <% if (new Date() <= new Date(job.hiringDate)) { %>
                            <% if (user && user.role === 'student') { %>
                                <form action="/events/part-time-jobs/apply/<%= job._id %>" method="POST">
                                    <button type="submit">Apply</button>
                                </form>
                            <% } %>
                        <% } %>
                    </td>

                    <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
                        <td>
                            <a href="/events/part-time-jobs/update-job?_id=<%= job._id %>" class="edit">Update</a>
                            |
                            <a href="/events/part-time-jobs/delete-job?_id=<%= job._id %>" class="delete" onclick="return confirm('Are you sure you want to delete this job?')">Delete</a>
                        </td>
                    <% } %>
                </tr>
            <% }) %>
        <% } else { %>
            <
                    No jobs found
                
        <% } %>
    </table>

</body>
</html>
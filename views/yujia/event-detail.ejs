<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= event.title %> — Campus Event Board</title>
  <link rel="stylesheet" href="/css/cca-detail.css">
  <style>
    .event-image img {
      width: 100%;
      max-height: 200px;
      object-fit: cover;
      border-radius: 10px;
      margin-bottom: 15px;
    }

    .detail-row { margin-bottom: 10px; color: #555; }
  </style>
</head>
<body>

  <%- include('../navbar') %>

  <% const spotsRemaining = event.capacity - confirmedCount; %>
  <% const isOver = new Date(event.endDate) < new Date(); %>

  <div class="container">
    <div class="card">
      

            <img src="/images/<%= event.image || 'default_cover.jpg' %>" 
            alt="<%= event.title %>"
            onerror="this.onerror=null; this.src='/images/default_cover.jpg';">


          <p><small><%= event.type %> — <%= event.careerType || '' %></small></p>
          <h2 class="event-title"><%= event.title %></h2>
          <p>by <strong><%= event.organizer %></strong></p>

          <hr class="divider">

          <div class="details">
            <div class="detail-row">
              <b>Date and Time:</b>
              <%= new Date(event.startDate).toLocaleString('en-SG', { timeZone: 'Asia/Singapore', weekday: 'short', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              to
              <%= new Date(event.endDate).toLocaleString('en-SG', { timeZone: 'Asia/Singapore', weekday: 'short', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </div>

            <% if (event.deadline) { %>
              <div class="detail-row">
                <b>Apply by:</b>
                <%= new Date(event.deadline).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'long', year: 'numeric' }) %>
              </div>
            <% } %>

            <% if (event.location) { %>
              <div class="detail-row"><b>Location:</b> <%= event.location %></div>
            <% } %>

            <% if (event.salary) { %>
              <div class="detail-row"><b>Salary:</b> $<%= event.salary %>/month</div>
            <% } %>

            <% if (event.sector) { %>
              <div class="detail-row"><b>Sector:</b> <%= event.sector %></div>
            <% } %>
          </div>

          <hr class="divider">

          <p style="white-space: pre-wrap;"><%= event.description %></p>
        </div>

       <div class="card">
          <h3>Interested?</h3>

          <% if (isOver) { %>
            <p>This event has ended.</p>

          <% } else if (event.applyLink && event.careerType !== 'workshop') { %>
            <p>Apply directly on the company's website.</p><br>
            <a href="<%= event.applyLink %>" class="btn btn-primary">Apply Now</a><br>

          <% } else { %>
            <p>This is a free workshop. Register to save your spot.</p>
            <form method="POST" action="/dashboard/rsvp-join">
              <input type="hidden" name="eventId" value="<%= event.eventId %>"/>
              <% if (state) { %>
                <button class="btn" type="submit" disabled><%= state === 'waitlist' ? 'Waitlisted' : 'Registered' %></button>
              <% } else { %>
                <button class="btn btn-primary" type="submit"><%= spotsRemaining > 0 ? 'Register' : 'Join Waitlist' %></button>
              <% } %>
            </form>
          <% } %>

          <hr class="divider">
            <br>


          <% if (event.careerType === 'workshop') { %>
            <% if (spotsRemaining > 0) { %>
              <p><%= event.capacity - confirmedCount %> spots remaining</p>
            <% } else { %>
              <p>Event full, <%= waitlistCount %> in queue</p>
            <% } %>
          <% } %>
        </div>
  </div>

</body>
</html>
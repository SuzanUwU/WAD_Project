<!DOCTYPE html>
<html>
<head>
  <title>Edit Event</title>
</head>
<body>

  <h1>Edit Event</h1>

  <form method="POST" action="/events/editevent" >
    <input type="hidden" name="eventId" value="<%= event._id %>">

    <table>
      <tr>
        <td style="text-align: right;">Title:</td>
        <td><input type="text" name="title" value="<%= event.title %>" required></td>
      </tr>

      <tr>
        <td style="text-align: right;">Category:</td>
        <td>
          <select name="category" required>
            <option value="">Select a category</option>
            <option value="CCA" <%= event.category === 'CCA' ? 'selected' : '' %>>CCA</option>
            <option value="Hackathon" <%= event.category === 'Hackathon' ? 'selected' : '' %>>Hackathon</option>
            <option value="Career" <%= event.category === 'Career' ? 'selected' : '' %>>Career</option>
            <option value="Part Time Jobs" <%= event.category === 'Part Time Jobs' ? 'selected' : '' %>>Part Time Jobs</option>
            <option value="Academic" <%= event.category === 'Academic' ? 'selected' : '' %>>Academic</option>
          </select>
        </td>
      </tr>

      <tr>
        <td style="text-align: right;">Date:</td>
        <td>
          <input type="datetime-local" name="date"
                 value="<%= new Date(event.date).toISOString().slice(0,16) %>"
                 required>
        </td>
      </tr>

      <tr>
        <td style="text-align: right;">Location:</td>
        <td><input type="text" name="location" value="<%= event.location || '' %>"></td>
      </tr>

      <tr>
        <td style="text-align: right;">Description:</td>
        <td><textarea name="description" rows="4" cols="40"><%= event.description || '' %></textarea></td>
      </tr>

      <tr>
        <td style="text-align: right;">Event Image (new):</td>
        <td><input type="file" name="eventImage" accept="image/*"></td>
      </tr>
    </table>

    <br>
    <input type="submit" value="Update Event"><br><br>
    <a href="/events/editevent">Cancel</a>
  </form>

</body>
</html>

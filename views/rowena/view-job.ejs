<!DOCTYPE html>
<html>
<head>
    <title>Part-Time Jobs</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fb;
            margin: 0;
            padding: 0;
        }

        h1 {
            text-align: center;
            color: #1e3a5f;
            margin: 20px 0;
        }

        .container {
            width: 90%;
            margin: 0 auto;
        }

        .top-bar {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .search-form {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        input, button {
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        button {
            background-color: #1e3a5f;
            color: white;
            cursor: pointer;
            border: none;
        }

        button:hover {
            background-color: #2c5282;
        }

        .cancel-btn {
            background-color: #999;
        }

        .cancel-btn:hover {
            background-color: #777;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 8px;
            overflow: hidden;
        }

        th, td {
            padding: 10px;
            text-align: center;
            border-bottom: 1px solid #eee;
        }

        th {
            background-color: #1e3a5f;
            color: white;
        }

        tr:hover {
            background-color: #f1f5ff;
        }

        a {
            text-decoration: none;
            color: #1e3a5f;
            font-weight: bold;
        }

        .create-btn {
            padding: 8px 12px;
            background-color: #1e3a5f;
            color: white;
            border-radius: 6px;
            text-decoration: none;
        }

        .link-bar {
            margin-bottom: 10px;
        }

        .link-bar a {
            margin-right: 15px;
        }
    </style>
</head>
<body>

    <h1>Part-Time Jobs</h1>

    <%- include('../navbar', { user: user }) %>

    <div class="container">
        <div class="link-bar">
            <a href="/all-events">Head back to all events</a>
        </div>

        <div class="top-bar">
            <form action="part-time-jobs/search-job" method="POST" class="search-form">
                <input type="text" name="keyword" placeholder="Search job...">
                <input type="number" name="money" placeholder="Salary">
                <button type="submit">Search</button>
                <button type="button" class="cancel-btn" onclick="window.location.href='/part-time-jobs'">Cancel</button>
            </form>

            <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
               <a href="/part-time-jobs/create" class="create-btn">+ Create New Job</a>
            <% } %>
        </div>

        <div class="link-bar">
            <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
                <a href="/part-time-jobs/applicants">View Job Applicants</a>
            <% } %>

            <% if (user && user.role === 'student') { %>
                <a href="/part-time-jobs/applied-job">View Applied Jobs</a>
            <% } %>
        </div>

        <table>
            <tr>
                <th>Logo</th>
                <th>Company</th>
                <th>Job Title</th>
                <th>Description</th>
                <th>Salary</th>
                <th>Start</th>
                <th>End</th>
                <th>Status</th>
                <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
                    <th>Modify</th>
                <% } %>
            </tr>

            <% if (joblist.length > 0) { %>
                <% joblist.forEach(job => { %>
                    <tr>

                        <td><img src="<%= job.companylogo ? '/images/' + job.companylogo : '/images/placeholder.png' %>"
       style="width:50px; height:50px; object-fit:cover;"></td>
                        <td><%= job.companyname %></td>
                        <td><%= job.jobtitle %></td>
                        <td><%= job.jobdescription %></td>
                        <td>$<%= job.salary %></td>
                        <td><%= job.startDate ? new Date(job.startDate).toLocaleDateString() : '' %></td>
                        <td><%= job.endDate ? new Date(job.endDate).toLocaleDateString() : '' %></td>
                        <td>
                            <%= new Date() > new Date(job.hiringDate) ? 'Expired' : 'Active' %>
                            <% if (new Date() <= new Date(job.hiringDate)  && user && user.role === 'student') { %>
                                <form action="/part-time-jobs/apply/<%= job._id %>" method="POST" style="margin:5px 0;">
                                    <button type="submit">Apply</button>
                                </form>
                            <% } %>
                        </td>
                        <% if (user && (user.role === 'admin' || user.role === 'superadmin')) { %>
                            <td>
                                <a href=" /part-time-jobs/update-job?_id=<%= job._id %>">Update</a> |
                                <a href="/part-time-jobs/delete-job?_id=<%= job._id %>" onclick="return confirm('Are you sure?')">Delete</a>
                            </td>
                        <% } %>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="<%= (user && (user.role === 'admin' || user.role === 'superadmin')) ? 10 : 9 %>">
                        No jobs found
                    </td>
                </tr>
            <% } %>
        </table>
    </div>
</body>
</html>
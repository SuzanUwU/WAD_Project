<!DOCTYPE html>
<html>
<head>
<title>Event Details</title>
</head>

<body>

<table width="100%">

<tr>

<td width="80">
<img src="/images/smu.webp" width="70">
</td>

<td>
<h1>SMU Event Details</h1>
</td>

</tr>

</table>

<br>

<table border="1" cellpadding="10" width="500">

<tr>
<td colspan="2" align="center">

<!-- ✅ FIXED IMAGE -->
<img src="/images/<%= event.image %>" width="400">

<h2><%= event.title %></h2>

</td>
</tr>

<tr>
<td><b>Category</b></td>
<td><%= event.category %></td>
</tr>

<tr>
<td><b>Club Type</b></td>
<td><%= event.clubType %></td>
</tr>

<tr>
<td><b>Date</b></td>
<td><%= event.date %></td>
</tr>

<tr>
<td><b>Location</b></td>
<td><%= event.location %></td>
</tr>

<tr>
<td valign="top"><b>Description</b></td>
<td><%= event.description %></td>
</tr>

</table>

<br>

<% if (registered) { %>

<p><b>You have already registered for this event.</b></p>

<a href="/events/my-events">
<button>View My Registered Events</button>
</a>

<% } else { %>

<!-- ✅ FIXED REGISTER -->
<form action="/events/<%= event._id %>/register" method="GET">
    <input type="hidden" name="studentId" value="12345">
    <button type="submit">Register for Event</button>
</form>

<% } %>

<br><br>

<a href="/events/cca">Back to CCA Events</a>

</body>
</html>
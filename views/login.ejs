<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 500px; margin: 50px auto; padding: 20px; }
    .error { color: #d32f2f; background: #ffebee; padding: 12px; border-radius: 4px; margin: 10px 0; }
    .success { color: #2e7d32; background: #e8f5e8; padding: 12px; border-radius: 4px; margin: 10px 0; }
    input { width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; }
    button { width: 100%; padding: 14px; background: #4CAF50; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer; }
    button:hover { background: #45a049; }
    .info { background: #e3f2fd; padding: 12px; border-radius: 4px; margin: 20px 0; font-size: 14px; }
    table { width: 100%; border-collapse: collapse; }
    td { padding: 8px 0; }
    a { color: #2196F3; text-decoration: none; }
  </style>
</head>
<body>
  <h1>🔐 Welcome Back!</h1>
  
  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>
  

  <form method="POST" action="/login">
    <table>
      <tr><td>Email:</td></tr>
      <tr><td>
        <input type="email" name="email" placeholder="name.year@school.smu.edu.sg" required>
      </td></tr>
      
      <tr><td>Password:</td></tr>
      <tr><td>
        <input type="password" name="password" placeholder="Enter your password" required minlength="6">
      </td></tr>
      
      <tr>
        <td colspan="2">
          <button type="submit">Login</button>  <!-- ✅ FIXED: "Login" not "Sign Up" -->
        </td>
      </tr>
    </table>
  </form>
  
  <p>
    Don't have an account? <a href="/signup">Sign Up</a>
  </p>
</body>
</html>

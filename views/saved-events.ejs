<!DOCTYPE html>
<html>
<head>
  <title>My Saved Events</title>
  <style>
      body { font-family: sans-serif; padding: 20px; max-width: 1000px; margin: 0 auto; background-color: #f4f7f6; }
      .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
      
      /* Grid layout for the event cards */
      .event-grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
          gap: 20px;
      }
      
      .event-card { 
          background: white; 
          border-radius: 8px; 
          overflow: hidden;
          box-shadow: 0 4px 6px rgba(0,0,0,0.1);
          border: 1px solid #ddd;
      }
      
      .event-image {
          width: 100%;
          height: 200px;
          object-fit: cover;
          background-color: #eee;
          display: flex;
          align-items: center;
          justify-content: center;
          color: #888;
      }
      
      .event-info { padding: 15px; }
      .event-title { margin: 0 0 10px 0; color: #285789; font-size: 1.2em; }
      .event-detail { margin: 5px 0; font-size: 0.9em; color: #555; }
      .empty-state { text-align: center; color: #666; font-style: italic; padding: 40px; background: white; border-radius: 8px; }
  </style>
</head>
<body>
    <div class="header">
        <h1><%= username %>'s Saved Events</h1>
        <a href="/all-events" style="padding: 10px 15px; background: #285789; color: white; text-decoration: none; border-radius: 5px;">← Back to All Events</a>
    </div>

    <% if (locals.error) { %>
        <p style="color: red;"><strong><%= error %></strong></p>
    <% } %>

    <div class="event-grid">
        <% if (events && events.length > 0) { %>
            
            <% events.forEach(function(event) { %>
                <div class="event-card">
                    <% if (event.image && event.image.data) { %>
                        <img class="event-image" src="data:<%= event.image.contentType %>;base64,<%= event.image.data.toString('base64') %>" alt="<%= event.title %>">
                    <% } else { %>
                        <div class="event-image">No Image Available</div>
                    <% } %>
                    
                    <div class="event-info">
                        <h3 class="event-title"><%= event.title %></h3>
                        <p class="event-detail"><strong>📅 Date:</strong> <%= event.date ? new Date(event.date).toLocaleDateString('en-GB') : 'TBD' %></p>
                        <p class="event-detail"><strong>📍 Location:</strong> <%= event.location || 'TBD' %></p>
                        <p class="event-detail"><strong>🏢 Organizer:</strong> <%= event.organizer || 'Campus Events Team' %></p>
                        
                        <a href="/events/<%= event._id %>" style="display: block; text-align: center; margin-top: 15px; padding: 8px; background-color: #eee; color: #333; text-decoration: none; border-radius: 4px;">
                            View Event Details
                        </a>

                        <button onclick="removeSavedEvent('<%= event._id %>', this)" style="display: block; width: 100%; text-align: center; margin-top: 10px; padding: 8px; background-color: #A52A2A; color: white; border: none; border-radius: 4px; cursor: pointer;">
                            🗑️ Remove from List
                        </button>
                    </div>
                </div>
            <% }); %>

        <% } else { %>
            <div class="empty-state" style="grid-column: 1 / -1;">
                <h2>Your list is looking a little empty!</h2>
                <p>You haven't saved any events yet, or the events you saved have been deleted by the organizer.</p>
                <br>
                <a href="/all-events" style="color: rgb(103, 164, 103); font-weight: bold; font-size: 1.1em;">Go find some events to attend!</a>
            </div>
        <% } %>
    </div>

    <script>
    async function removeSavedEvent(eventId, buttonElement) {
        // Optional: Ask for confirmation before deleting
        if (!confirm("Are you sure you want to remove this event from your saved list?")) {
            return;
        }

        try {
            // Change button text so the user knows it's working
            const originalText = buttonElement.innerHTML;
            buttonElement.innerHTML = 'Removing...';
            buttonElement.disabled = true;

            // Send the DELETE request to our new backend route
            // (Notice we use the /all-events prefix here!)
            const response = await fetch(`/all-events/unsave-event/${eventId}`, {
                method: 'DELETE'
            });

            if (response.ok) {
                // Success! Find the whole event card and make it disappear smoothly
                const card = buttonElement.closest('.event-card');
                card.style.transition = "opacity 0.3s ease";
                card.style.opacity = "0";
                
                setTimeout(() => {
                    card.remove();
                    
                    // Optional: If that was the last card, reload to show the empty state
                    if (document.querySelectorAll('.event-card').length === 0) {
                        window.location.reload();
                    }
                }, 300); // Waits for the fade-out animation to finish

            } else {
                const result = await response.json();
                alert('Could not remove: ' + result.error);
                buttonElement.innerHTML = originalText;
                buttonElement.disabled = false;
            }
        } catch (err) {
            console.error("Remove Error:", err);
            alert('Failed to connect to the server.');
            buttonElement.innerHTML = '🗑️ Remove from List';
            buttonElement.disabled = false;
        }
    }
</script>
</body>
</html>
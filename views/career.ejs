<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Careers</title>
  <style>
    #toast {
    position: fixed;
    top: 5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100; 
    background: #333;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-size: 0.9rem;
  }
</style>
</head>
<body>
   <% if (typeof msg !== 'undefined' && msg) { %>
  <div id="toast"><%= msg %></div>
  <% } %>
  <%- include('./navbar') %>


  <h1>Career Opportunities</h1>
  <p>Personalised support, hands-on workshops, and networking to take charge of your journey.</p>
  <hr/>

  <table width="100%" cellpadding="0">
    <tr valign="top">

      <!-- LEFT: FILTER SIDEBAR -->
      <td width="240" style="padding-right: 2rem; border-right: 1px solid #ccc;">

        <h3>Filter</h3>
        <form action="/career-events" method="GET">

          <label>Search<br/>
            <input type="text" name="q" placeholder="Role, keyword..." value="<%= q || '' %>"/>
          </label>
          <br/><br/>

          <label>Type<br/>
            <select name="careerType">
              <option value="">All types</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>" <%= careerType === cat ? 'selected' : '' %>><%= cat %></option>
              <% }) %>
            </select>
          </label>
          <br/><br/>

          <fieldset>
            <legend>Sector</legend>
            <% sectors.forEach(s => { %>
              <label>
                <input type="checkbox" name="selectedSectors" value="<%= s %>"
                  <%= selectedSectors && selectedSectors.includes(s) ? 'checked' : '' %>/>
                <%= s %>
              </label><br/>
            <% }) %>
          </fieldset>
          <br/>

          From: <input type="date" name="dateFrom" value="<%= dateFrom || '' %>"/><br/>
          To: &nbsp;&nbsp;<input type="date" name="dateTo" value="<%= dateTo || '' %>"/>
          <br/><br/>
          <input type="hidden" name="filtered" value="True">
          <input type="submit" value="Search">
          <a href="/career-events">Clear</a>

        </form>
      
      </td>

      <!-- RIGHT: MAIN CONTENT -->
      <td style="padding-left: 2rem;">

        <!-- SAVED -->
        <h2>Saved</h2>
        <% if (pinned && pinned.length > 0) { %>
          <table border="1" cellpadding="6">
            <tr>
              <% pinned.forEach(event => { %>
                <td>
                  <small>[<%= rsvps.find(r => r.event.toString() === event.eventId.toString()).status %>]</small><br/>
                  <a href="/career-events/detail?id=<%= event.eventId %>"><%= event.title %></a><br/>
                  <%= event.organizer %><br/>
                  <%= new Date(event.startDate).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td> 
              <% }) %>
            </tr>
          </table>
        <% } else { %>
          <p>No saved events.</p>
        <% } %>

        <hr/>

        <!-- WORKSHOPS -->
        <h2>Workshops &amp; Coaching</h2>
        <% if (workshops && workshops.length > 0) { %>
          <table border="1" cellpadding="6">
            <tr>
              <% workshops.forEach(event => { %>
                <td>
                  <small>[Workshop]</small><br/>
                  <a href="/career-events/detail?id=<%= event.eventId %>"><%= event.title %></a><br/>
                  <%= event.organizer %><br/>
                  <%= new Date(event.startDate).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'short', year: 'numeric' }) %><br/>
                  <%= event.location || '—' %>
                </td>
              <% }) %>
            </tr>
          </table>
        <% } else { %>
          <p>No workshops found.</p>
        <% } %>

        <hr/>

        <!-- JOBS -->
        <h2>Jobs &amp; Internships</h2>
        <% if (jobs && jobs.length > 0) { %>
          <table border="1" cellpadding="6">
            <tr>
              <% jobs.forEach(event => { %>
                <td>
                  <small>[<%= event.careerType || '—' %>]</small><br/>
                  <a href="/career-events/detail?id=<%= event.eventId %>"><%= event.title %></a><br/>
                  <%= event.organizer %><br/>
                  <% if (event.salary) { %>$<%= event.salary %>/month<br/><% } %>
                  <%= event.sector || '—' %><br/>
                  <% if (event.deadline) { %>
                    Deadline: <%= new Date(event.deadline).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'short', year: 'numeric' }) %>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          </table>
        <% } else { %>
          <p>No jobs found.</p>
        <% } %>

        <hr/>

        <!-- ADMIN PANEL -->
        <% if (user && user.role !== 'student') { %>

          <h2>Admin — Manage Career Events</h2>

          <!-- CREATE FORM -->
           <!-- turn into modal when css is implemented -->
          <form method="get" action="/career-events/form?id=">
            <input type="submit" value="Create new career event"> 
          </form>
          <br/>

          <!-- EVENTS TABLE WITH EDIT/DELETE -->
          <%
            const allEvents = [...(jobs || []), ...(workshops || [])];
          %>
          <% if (allEvents.length > 0) { %>
            <table border="1" cellpadding="6" width="100%">
              <tr>
                <th>Title</th>
                <th>Organizer</th>
                <th>Type</th>
                <th>Sector</th>
                <th>Start Date</th>
                <th>Actions</th>
              </tr>
              <% allEvents.forEach(event => { %>
                <tr>
                  <td><%= event.title %></td>
                  <td><%= event.organizer %></td>
                  <td><%= event.careerType || '—' %></td>
                  <td><%= event.sector || '—' %></td>
                  <td><%= new Date(event.startDate).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                  <td>
                    
                    <form method="GET" action="/career-events/form" style="display:inline">
                      <input type="hidden" name="id" value="<%= event._id %>"/>
                      <input type="submit" value="Edit"/>
                    </form>

                    <form method="POST" action="/career-events/career-delete" style="display:inline">
                      <input type="hidden" name="careerID" value="<%= event._id %>"/>
                      <button type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </table>
          <% } %>

        <% } %>

      </td>
    </tr>
  </table>
<script>
  const toast = document.getElementById('toast');
  if (toast) setTimeout(() => toast.remove(), 3000);
</script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
  <title>All Events</title>
</head>
<body>
  
  <!-- LATEST EVENTS SECTION -->
  <h1>Latest Events</h1>
  <% const latestEvents = events.slice(0, 6); %>
  <% if (latestEvents.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse; margin-bottom: 40px; table-layout: fixed;">
      <!-- ROW 1: Images -->
      <tr>
        <% latestEvents.forEach(function(event) { %>
          <td colspan="2" style="width: 220px; vertical-align: top; height: 300px;">
            <% if (event.image && event.image.data) { %>
              <img src="data:<%= event.image.contentType %>;base64,<%= event.image.data.toString('base64') %>" 
                   alt="<%= event.title %>" width=100% height="300" style="display: block;">
            <% } else { %>
              <div style="width: 200px; height: 140px; background: #eee; text-align: center; line-height: 140px;">
                No Image
              </div>
            <% } %>
          </td>
        <% }) %>
      </tr>
      
      <!-- ROW 2: Titles -->
      <tr>
        <% latestEvents.forEach(function(event) { %>
          <td colspan="2" style="width: 220px; word-wrap: break-word;"><strong><%= event.title %></strong></td>
        <% }) %>
      </tr>
      
      <!-- ROW 3: Organizers -->
      <tr>
        <% latestEvents.forEach(function(event) { %>
          <td colspan="2" style="width: 220px; word-wrap: break-word;"><strong>Organizer:</strong> <%= event.organizer || 'Campus Events Team' %></td>
        <% }) %>
      </tr>
      
      <!-- ROW 4: Descriptions -->
      <tr>
        <% latestEvents.forEach(function(event) { %>
          <td colspan="2" style="width: 220px; word-wrap: break-word;"><%= event.description || 'No description available' %></td>
        <% }) %>
      </tr>
      
      <!-- ROW 5: Date -->
      <tr>
        <% latestEvents.forEach(function(event) { %>
          <td style="width: 90px; word-wrap: break-word;">Date:</td>
          <td style="width: 130px; word-wrap: break-word;"><%= event.date ? new Date(event.date).toLocaleDateString('en-GB') : 'TBD' %></td>
        <% }) %>
      </tr>
      
      <!-- ROW 6: Time -->
      <tr>
        <% latestEvents.forEach(function(event) { %>
          <td style="width: 90px; word-wrap: break-word;">Time:</td>
          <td style="width: 130px; word-wrap: break-word;"><%= event.date ? new Date(event.date).toLocaleTimeString('en-SG', {hour: '2-digit', minute: '2-digit'}) + ' - 18:00' : 'TBD' %></td>
        <% }) %>
      </tr>
      
      <!-- ROW 7: Location -->
      <tr>
        <% latestEvents.forEach(function(event) { %>
          <td style="width: 60px; word-wrap: break-word;">Location:</td>
          <td style="width: 160px; word-wrap: break-word;"><%= event.location || 'TBD' %></td>
        <% }) %>
      </tr>
      
      <!-- ROW 8: Buttons -->
      <tr>
        <% latestEvents.forEach(function(event) { %>
          <td style="width: 150px; text-align: center;"><button style="background-color: rgb(159, 222, 159); width: 80%; height: 25px" onclick="register('<%= event._id %>')">Register</button></td>
          <td style="width: 150px; text-align: center;">
            <button style="background-color: rgb(226, 226, 153); width: 80%; height: 25px;" 
                    onclick="saveEvent('<%= event._id %>', '<%= event.title %>', this)">
              Save
            </button>
          </td>
        <% }) %>
      </tr>
    </table>
  <% } %>

  <!-- ALL EVENTS SECTION (same structure) -->
  <h1>All Events</h1>
  <% const allEvents = events.slice(3); %>
  <% if (allEvents.length > 0) { %>
    <% const firstBatch = allEvents.slice(0, 3); %>
    <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse; margin-bottom: 40px; table-layout: fixed;">
      <!-- ROW 1-8: Same structure with fixed widths -->
      <tr><% firstBatch.forEach(function(event) { %><td colspan="2" style="width: 220px; vertical-align: top;"><% if (event.image && event.image.data) { %><img src="data:<%= event.image.contentType %>;base64,<%= event.image.data.toString('base64') %>" alt="<%= event.title %>" width="200" height="140" style="display: block;"><% } else { %><div style="width: 200px; height: 140px; background: #eee; text-align: center; line-height: 140px;">No Image</div><% } %></td><% }) %><% for(let i = firstBatch.length; i < 3; i++) { %><td colspan="2" style="width: 220px;"></td><% } %></tr>
      <tr><% firstBatch.forEach(function(event) { %><td colspan="2" style="width: 220px; word-wrap: break-word;"><strong><%= event.title %></strong></td><% }) %><% for(let i = firstBatch.length; i < 3; i++) { %><td colspan="2" style="width: 220px;"></td><% } %></tr>
      <tr><% firstBatch.forEach(function(event) { %><td colspan="2" style="width: 220px; word-wrap: break-word;"><strong>Organizer:</strong> <%= event.organizer || 'Campus Events Team' %></td><% }) %><% for(let i = firstBatch.length; i < 3; i++) { %><td colspan="2" style="width: 220px;"></td><% } %></tr>
      <tr><% firstBatch.forEach(function(event) { %><td colspan="2" style="width: 220px; word-wrap: break-word;"><%= event.description || 'No description available' %></td><% }) %><% for(let i = firstBatch.length; i < 3; i++) { %><td colspan="2" style="width: 220px;"></td><% } %></tr>
      <tr><% firstBatch.forEach(function(event) { %><td style="width: 110px; word-wrap: break-word;">Date:</td><td style="width: 110px; word-wrap: break-word;"><%= event.date ? new Date(event.date).toLocaleDateString('en-GB') : 'TBD' %></td><% }) %><% for(let i = firstBatch.length; i < 3; i++) { %><td style="width: 110px;"></td><td style="width: 110px;"></td><% } %></tr>
      <tr><% firstBatch.forEach(function(event) { %><td style="width: 110px; word-wrap: break-word;">Time:</td><td style="width: 110px; word-wrap: break-word;"><%= event.date ? new Date(event.date).toLocaleTimeString('en-SG', {hour: '2-digit', minute: '2-digit'}) + ' - 18:00' : 'TBD' %></td><% }) %><% for(let i = firstBatch.length; i < 3; i++) { %><td style="width: 110px;"></td><td style="width: 110px;"></td><% } %></tr>
      <tr><% firstBatch.forEach(function(event) { %><td style="width: 110px; word-wrap: break-word;">Location:</td><td style="width: 110px; word-wrap: break-word;"><%= event.location || 'TBD' %></td><% }) %><% for(let i = firstBatch.length; i < 3; i++) { %><td style="width: 110px;"></td><td style="width: 110px;"></td><% } %></tr>
      <tr><% firstBatch.forEach(function(event) { %><td style="width: 110px; text-align: center;"><button onclick="register('<%= event._id %>')">Register</button></td><td style="width: 110px; text-align: center;"><button onclick="saveEvent('<%= event._id %>')">Save</button></td><% }) %><% for(let i = firstBatch.length * 2; i < 6; i++) { %><td style="width: 110px;"></td><% } %></tr>
    </table>
  <% } %>
  <br>

  <!--For Saved Events with User001 ID for testing-->
  <h2>Saved Events - User001</h2>
  <div id="savedEventsContainer">
    <table border="1" cellpadding="6" cellspacing="0" id="savedEventsTable" style="border-collapse: collapse;">
      <thead>
        <tr>
          <th>Event Name</th>
          <th>Event ID</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="savedEventsBody">
        <!-- Dynamic content added here by JavaScript -->
      </tbody>
    </table>
  </div>

  <!-- CALENDAR SECTION -->
  <div style="margin-top: 40px;">
    <h2>2026 Events Calendar</h2>
    
    <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 20px;">
      <button onclick="prevMonth()" style="padding: 10px 20px; font-size: 16px;">← Prev</button>
      <h3 id="currentMonthYear" style="margin: 0;"></h3>
      <button onclick="nextMonth()" style="padding: 10px 20px; font-size: 16px;">Next →</button>
    </div>
    
    <table border="1" cellpadding="10" cellspacing="0" id="calendarTable" style="border-collapse: collapse;">
      <thead>
        <tr style="background-color: #f0f0f0;">
          <th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th>
        </tr>
      </thead>
      <tbody id="calendarDays">
        <!-- JavaScript fills 6 rows x 7 columns -->
      </tbody>
    </table>
  </div>

  <script>
  let currentDate = new Date(2026, 0, 1); // Jan 2026
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  function generateCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    document.getElementById('currentMonthYear').textContent = `${months[month]} ${year}`;
    
    const firstDay = new Date(year, month, 1).getDay(); // 0=Sun, 6=Sat
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    
    const tbody = document.getElementById('calendarDays');
    tbody.innerHTML = ''; // Clear
    
    let dayCount = 1;
    
    // Create 6 weeks (42 cells total)
    for (let week = 0; week < 6; week++) {
      const row = tbody.insertRow();
      
      for (let col = 0; col < 7; col++) {
        const cell = row.insertCell();
        
        // Empty cells before month starts
        if (week === 0 && col < firstDay) {
          cell.textContent = '';
          cell.style.backgroundColor = '#f5f5f5';
        }
        // Current month days
        else if (dayCount <= daysInMonth) {
          cell.textContent = dayCount;
          cell.style.cursor = 'pointer';
          cell.style.textAlign = 'center';
          cell.style.padding = '10px';
          dayCount++;
          
          // Highlight weekends
          if (col === 0 || col === 6) {
            cell.style.backgroundColor = '#ffebee';
          }
          
          cell.onclick = () => alert(`Selected: ${months[month]} ${cell.textContent}, ${year}`);
        }
        // Empty cells after month ends
        else {
          cell.textContent = '';
          cell.style.backgroundColor = '#f5f5f5';
        }
      }
    }
  }

  function nextMonth() {
    currentDate.setMonth(currentDate.getMonth() + 1);
    generateCalendar();
  }

  function prevMonth() {
    currentDate.setMonth(currentDate.getMonth() - 1);
    generateCalendar();
  }

  generateCalendar(); // Jan 2026
  </script>

  <!--Create new event-->
  <br>
  <a href="/events/create">Create New Event</a>
  
  <script>
  function register(eventId) { alert('Register: ' + eventId); }

  async function saveEvent(eventId, eventTitle, button) {
    try {
      const response = await fetch(`/events/save/${eventId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      
      const result = await response.json();
      if (result.success) {
        button.style.backgroundColor = 'rgb(144, 238, 144)';
        button.textContent = 'Saved ✓';
        button.disabled = true;
        loadSavedEvents(); // Refresh saved table
      } else {
        alert(result.error || 'Save failed');
      }
    } catch (err) {
      alert('Save failed: ' + err.message);
    }
  }

  async function removeSavedEvent(index, eventId) {
    try {
      const response = await fetch(`/events/unsave/${eventId}`, {
        method: 'DELETE'
      });
      
      const result = await response.json();
      if (result.success) {
        // Reset Save button (find by eventId)
        const saveButton = document.querySelector(`button[onclick*="saveEvent('${eventId}'"]`);
        if (saveButton) {
          saveButton.style.backgroundColor = 'rgb(226, 226, 153)';
          saveButton.textContent = 'Save';
          saveButton.disabled = false;
        }
        loadSavedEvents();
      }
    } catch (err) {
      alert('Remove failed');
    }
  }

  async function loadSavedEvents() {
    const response = await fetch('/events/saved/user001');
    const data = await response.json();
    // Update your saved events table with data.savedEvents
  }
  </script>

</body>
</html>

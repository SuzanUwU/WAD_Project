<!DOCTYPE html>
<html>
<head>
  <title>Update Job</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f7fb;
      margin: 0;
      padding: 0;
    }

    h1, h2 {
      text-align: center;
      margin-top: 30px;
      color: #1e3a5f;
    }

    .form-container {
      width: 70%;
      margin: 30px auto;
      background: white;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    td {
      padding: 12px;
      vertical-align: middle;
    }

    .label {
      font-weight: bold;
      color: #1e3a5f;
      width: 25%;
      text-align: right;
    }

    input[type="text"],
    input[type="number"],
    input[type="date"],
    textarea {
      width: 95%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 14px;
    }

    textarea {
      resize: vertical;
      min-height: 80px;
    }

    .btn-row {
      text-align: center;
      padding-top: 20px;
    }

    button {
      padding: 12px 20px;
      border: none;
      background-color: #1e3a5f;
      color: white;
      border-radius: 8px;
      cursor: pointer;
      font-size: 15px;
    }

    button:hover {
      background-color: #2c5282;
    }

    .back-link {
      display: block;
      width: 200px;
      margin: 20px auto;
      text-align: center;
      padding: 12px;
      background-color: #1e3a5f;
      color: white;
      border-radius: 10px;
      text-decoration: none;
    }

    .back-link:hover {
      background-color: #2c5282;
    }

    .msg {
      text-align: center;
      color: red;
      font-weight: bold;
      margin-bottom: 15px;
    }
  </style>
</head>
<body>
  <%- include('../navbar') %>
  <% if (found) { %>
    <h2>Update Job <%= found.jobtitle %></h2>
  <% } else { %>
    <h2>Job could not be found</h2>
  <% } %>

  <div class="form-container">

    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="msg"><%= msg %></div>
    <% } %>

    <% if (found) { %>
      <form action="/events/part-time-jobs/update-job" method="POST">
        
        <input type="hidden" name="_id" value="<%= found._id %>">

        <table>
          <tr>
            <td class="label">Company Name:</td>
            <td><input type="text" name="companyname" value="<%= found.companyname %>" required></td>
          </tr>

          <tr>
            <td class="label">Company Logo:</td>
            <td><input type="text" name="companylogo" value="<%= found.companylogo %>" required></td>
          </tr>

          <tr>
            <td class="label">Job Title:</td>
            <td><input type="text" name="jobtitle" value="<%= found.jobtitle %>" required></td>
          </tr>

          <tr>
            <td class="label">Job Description:</td>
            <td>
              <textarea name="jobdescription" required><%= found.jobdescription %></textarea>
            </td>
          </tr>

          <tr>
            <td class="label">Salary:</td>
            <td><input type="number" name="salary" value="<%= found.salary %>" required></td>
          </tr>

          <tr>
            <td class="label">Start Date:</td>
            <td>
              <input type="date" name="startDate" value="<%= found.startDate ? found.startDate.toISOString().split('T')[0] : '' %>" required>
            </td>
          </tr>

          <tr>
            <td class="label">End Date:</td>
            <td>
              <input type="date" name="endDate" value="<%= found.endDate ? found.endDate.toISOString().split('T')[0] : '' %>" required>
            </td>
          </tr>

          <tr>
            <td class="label">Hiring Date:</td>
            <td>
              <input type="date" name="hiringDate" value="<%= found.hiringDate ? found.hiringDate.toISOString().split('T')[0] : '' %>" required>
            </td>
          </tr>

          <tr>
            <td colspan="2" class="btn-row">
              <button type="submit">Update Job</button>
            </td>
          </tr>
        </table>
      </form>
    <% } %>
  </div>

  <a href="/events/part-time-jobs" class="back-link">Back to Job List</a>

</body>
</html>

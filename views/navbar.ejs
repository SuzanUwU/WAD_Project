<style>
  /* Pure CSS Navbar - Unified dropdown style */
  .navbar-pure {
    position: fixed;
    top: 0;
    width: 100%;
    background: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
    z-index: 1000;
    padding: 0.75rem 1rem;
    font-family: system-ui, sans-serif;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav-left { flex-shrink: 0; }
  .nav-center { 
    display: flex; 
    align-items: center; 
    gap: 1.5rem; 
    flex: 1;
    justify-content: center;
  }
  .nav-right { 
    display: flex; 
    align-items: center; 
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 600;
    color: #212529;
    text-decoration: none;
  }
  .logo i { color: #0d6efd; margin-right: 0.5rem; }

  .nav-link {
    color: #495057;
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .nav-link:hover { background: #e9ecef; }
  .nav-link i { margin-right: 0.5rem; font-size: 1.1em; }

  /* UNIFIED DROPDOWN STYLE for both Events & User */
  .dropdown-container {
    position: relative;
  }
  .dropdown-trigger {
    color: #495057;
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    white-space: nowrap;
    cursor: pointer;
  }
  .dropdown-trigger:hover { background: #e9ecef; }
  .dropdown-trigger i { margin-right: 0.5rem; font-size: 1.1em; }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: white;
    min-width: 220px;
    max-width: 280px;
    box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
    border: 1px solid #dee2e6;
    border-radius: 0.5rem;
    padding: 0.5rem 0;
    margin-top: 0rem;
    z-index: 1100;
  }
  /* Events dropdown centers, User aligns right */
  .user-dropdown .dropdown-menu {
    left: auto;
    right: 0;
    transform: none;
  }

  .dropdown-container:hover .dropdown-menu { 
    display: block; 
  }
  .dropdown-item {
    display: block;
    padding: 0.75rem 1.25rem;
    color: #495057;
    text-decoration: none;
    transition: background 0.2s;
  }
  .dropdown-item:hover { background: #f8f9fa; }

  /* User Profile */
  .user-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .nav-container { flex-direction: column; gap: 1rem; }
    .nav-center { order: 3; flex-wrap: wrap; justify-content: center; }
    .nav-right { order: 2; }
    .dropdown-menu { position: static; transform: none; box-shadow: none; background: #e9ecef; margin-top: 0; }
  }

  body { padding-top: 70px; }
</style>

<nav class="navbar-pure">
  <div class="nav-container">
    <!-- Logo LEFT -->
    <a href="/" class="logo">
      <i class="fas fa-calendar-alt"></i>Events Hub
    </a>

    <!-- Links CENTER -->
    <div class="nav-center">
      <a href="#saved-events" class="nav-link">
        <i class="fas fa-clock"></i>My Saved Events
      </a>
      <a href="#latest-events" class="nav-link">
        <i class="fas fa-clock"></i>Latest Events
      </a>
      <a href="#all-events" class="nav-link">
        <i class="fas fa-list"></i>All Events
      </a>
      
      <!-- Events Dropdown - SAME STYLE -->
      <div class="dropdown-container events-dropdown">
        <div class="dropdown-trigger">
          <i class="fas fa-calendar-days"></i>Events
        </div>
        <div class="dropdown-menu">
          <a href="/cca" class="dropdown-item">CCA Events</a>
          <a href="/hack-events/hackathons" class="dropdown-item">Hackathon Events</a>
          <a href="/events/part-time-jobs" class="dropdown-item">Part Time Jobs</a>
          <a href="/events/career" class="dropdown-item">Career Events</a>
        </div>
      </div>
    </div>

    <!-- User RIGHT -->
    <div class="nav-right">
      <% if (user) { %>
        <div class="user-section">
          <div class="user-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
          <!-- User Dropdown - IDENTICAL STYLE -->
          <div class="dropdown-container user-dropdown">
            <div class="dropdown-trigger">
              <span class="user-name"><%= user.username %></span>
            </div>
            <div class="dropdown-menu">
              <a href="/usersettings" class="dropdown-item">Profile (<%= user.userId %>)</a>
              <a href="/logout" class="dropdown-item">Logout</a>
              <% if (user.role === 'superadmin') { %>
                <a href="/superadmin/admins-settings" class="dropdown-item">👑 Admin Settings</a>
              <% } %>
            </div>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="nav-link">
          <i class="fas fa-sign-in-alt"></i>Login
        </a>
      <% } %>
    </div>
  </div>
</nav>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Edit CCA Event</title>

<style>
body {
    font-family: Arial, sans-serif;
    background-color: #f5f6fa;
    margin: 0;
}

/* HEADER */
.header {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 20px;
    background-color: white;
    border-bottom: 1px solid #ddd;
}

/* CONTAINER */
.container {
    width: 60%;
    margin: 30px auto;
}

/* CARD */
.card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
}

/* IMAGE */
.event-image {
    text-align: center;
    margin-bottom: 15px;
}

.event-image img {
    width: 250px;
    height: 180px;
    object-fit: cover;
    border-radius: 10px;
}

/* FORM */
.form-group {
    margin-bottom: 15px;
}

input, textarea, select {
    width: 100%;
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #ccc;
}

/* BUTTON */
.btn {
    padding: 10px 16px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
}

.btn-primary {
    background-color: #4CAF50;
    color: white;
}
</style>

</head>

<body>

<!-- HEADER -->
<div class="header">
    <img src="/images/smu.webp" width="70">
    <h1>Edit Event</h1>
</div>

<div class="container">

<div class="card">

<form action="/cca-events/ccaAdmin/<%= cca._id %>/edit" method="POST" enctype="multipart/form-data">

<!-- IMAGE -->
<div class="event-image">
<% if (event.image && event.image.data) { %>
    <img src="data:<%= event.image.contentType %>;base64,<%= event.image.data.toString('base64') %>">
<% } else { %>
    <img src="/images/default.png">
<% } %>
</div>

<div class="form-group">
    <label>Change Image</label>
    <input type="file" name="image">
</div>

<!-- TITLE -->
<div class="form-group">
    <label>Title</label>
    <input name="title" value="<%= event.title %>" required>
</div>

<!-- ORGANIZER -->
<div class="form-group">
    <label>Organizer</label>
    <input name="organizer" value="<%= event.organizer %>" required>
</div>

<!-- START DATE -->
<div class="form-group">
    <label>Start Date</label>
    <input 
        type="date" 
        name="startDate" 
        value="<%= event.startDate ? event.startDate.toISOString().split('T')[0] : '' %>" 
        required
    >
</div>

<!-- END DATE -->
<div class="form-group">
    <label>End Date</label>
    <input 
        type="date" 
        name="endDate" 
        value="<%= event.endDate ? event.endDate.toISOString().split('T')[0] : '' %>" 
        required
    >
</div>

<!-- LOCATION -->
<div class="form-group">
    <label>Location</label>
    <input name="location" value="<%= event.location %>" required>
</div>

<!-- CLUB TYPE (DROPDOWN FIXED) -->
<div class="form-group">
    <label>Club Type</label>
    <select name="clubType" required>
        <option value="">-- Select Club Type --</option>
        <option value="Sports" <%= cca.clubType === "Sports" ? "selected" : "" %>>Sports</option>
        <option value="Arts" <%= cca.clubType === "Arts" ? "selected" : "" %>>Arts</option>
        <option value="Academic" <%= cca.clubType === "Academic" ? "selected" : "" %>>Academic</option>
        <option value="Community" <%= cca.clubType === "Community" ? "selected" : "" %>>Community</option>
        <option value="Leadership" <%= cca.clubType === "Leadership" ? "selected" : "" %>>Leadership</option>
    </select>
</div>

<!-- CAPACITY -->
<div class="form-group">
    <label>Capacity</label>
    <input type="number" name="capacity" value="<%= cca.capacity %>">
</div>

<!-- DESCRIPTION -->
<div class="form-group">
    <label>Description</label>
    <textarea name="description" rows="4" required><%= event.description %></textarea>
</div>

<button type="submit" class="btn btn-primary">
    Update Event
</button>

</form>

<br>

<a href="/cca-events/ccaAdmin">← Back to Admin Events</a>

</div>

</div>

</body>
</html>
<!DOCTYPE html>
<html>
<head>
<title>Create CCA vent</title>

<style>
body {
    font-family: Arial, sans-serif;
    background-color: #f5f6fa;
    margin: 0;
}

/* CONTAINER */
.container {
    width: 60%;
    margin: 30px auto;
}

/* CARD */
.card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
}

/* FORM */
.form-group {
    margin-bottom: 15px;
}

label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

input, textarea, select {    
    width: 100%;
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #ccc;
}

/* ERROR */
.error {
    color: red;
    font-size: 13px;
    margin-top: 5px;
}

.error-box {
    background: #ffe0e0;
    color: #a00;
    padding: 10px;
    border-radius: 6px;
    margin-bottom: 15px;
}

/* BUTTON */
.btn {
    padding: 10px 16px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
}

.btn-primary {
    background-color: #4CAF50;
    color: white;
}

.btn-primary:hover {
    background-color: #45a049;
}

/* BACK LINK */
.back-link {
    display: inline-block;
    margin-top: 15px;
}
</style>

</head>

<body>

<%- include('../navbar', { user: user }) %>

<div class="container">
<div class="card">

<% if (errors && Object.keys(errors).length > 0) { %>
  <div class="error-box">
    Please fix the errors below.
  </div>
<% } %>

<form action="/cca-events/ccaAdmin/create" method="POST">

<!-- TITLE -->
<div class="form-group">
    <label>Title</label>
    <input type="text" name="title" required value="<%= formData?.title || '' %>">
    <% if (errors?.title) { %>
        <div class="error"><%= errors.title %></div>
    <% } %>
</div>

<!-- ORGANIZER -->
<div class="form-group">
    <label>Organizer</label>
    <input type="text" name="organizer" required value="<%= formData?.organizer || '' %>">
    <% if (errors?.organizer) { %>
        <div class="error"><%= errors.organizer %></div>
    <% } %>
</div>

<!-- IMAGE -->
<div class="form-group">
    <label>Club Image (optional)</label>
    <input type="text" name="image" value="<%= formData?.image || '' %>" placeholder="e.g. smu.jpg">
</div>

<!-- START DATE -->
<div class="form-group">
    <label>Start Date</label>
    <input type="date" name="startDate" required value="<%= formData?.startDate || '' %>">
    <% if (errors?.startDate) { %>
        <div class="error"><%= errors.startDate %></div>
    <% } %>
</div>

<!-- END DATE -->
<div class="form-group">
    <label>End Date</label>
    <input type="date" name="endDate" required value="<%= formData?.endDate || '' %>">
    <% if (errors?.endDate) { %>
        <div class="error"><%= errors.endDate %></div>
    <% } %>
</div>

<!-- DEADLINE -->
<div class="form-group">
    <label>Registration Deadline</label>
    <input type="date" name="deadline" value="<%= formData?.deadline || '' %>">
    <% if (errors?.deadline) { %>
        <div class="error"><%= errors.deadline %></div>
    <% } %>
</div>

<!-- LOCATION -->
<div class="form-group">
    <label>Location</label>
    <input 
        type="text" 
        name="location" 
        required 
        placeholder="e.g. SMU Campus, Room 2-3"
        value="<%= formData?.location || '' %>"
    >
    <% if (errors?.location) { %>
        <div class="error"><%= errors.location %></div>
    <% } %>
</div>

<!-- CLUB TYPE -->
<div class="form-group">
    <label>Club Type</label>
    <select name="clubType" required>
        <option value="">-- Select Club Type --</option>
        <option value="Sports" <%= formData?.clubType === "Sports" ? "selected" : "" %>>Sports</option>
        <option value="Arts" <%= formData?.clubType === "Arts" ? "selected" : "" %>>Arts</option>
        <option value="Academic" <%= formData?.clubType === "Academic" ? "selected" : "" %>>Academic</option>
        <option value="Community" <%= formData?.clubType === "Community" ? "selected" : "" %>>Community</option>
        <option value="Leadership" <%= formData?.clubType === "Leadership" ? "selected" : "" %>>Leadership</option>
    </select>
    <% if (errors?.clubType) { %>
        <div class="error"><%= errors.clubType %></div>
    <% } %>
</div>

<!-- CAPACITY -->
<div class="form-group">
    <label>Capacity</label>
    <input 
        type="number" 
        name="capacity" 
        required 
        min="1"
        step="1"
        oninput="this.value = this.value.replace(/[^0-9]/g, '')"
        value="<%= formData?.capacity || '' %>"
    >
    <% if (errors?.capacity) { %>
        <div class="error"><%= errors.capacity %></div>
    <% } %>
</div>

<!-- DESCRIPTION -->
<div class="form-group">
    <label>Description</label>
    <textarea 
        name="description" 
        required 
        placeholder="Describe your event..."
    ><%= formData?.description || '' %></textarea>

    <% if (errors?.description) { %>
        <div class="error"><%= errors.description %></div>
    <% } %>
</div>

<button type="submit" class="btn btn-primary">
    Create Event
</button>

</form>

<a href="/cca-events/ccaAdmin" class="back-link">
    Back to Admin Events
</a>

</div>
</div>

</body>
</html>
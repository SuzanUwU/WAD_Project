<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Attendees — <%= hackathon.name %></title>
</head>
<body>

  <%- include('../navbar') %>

<h1>Attendees — <%= hackathon.name %></h1>
<p><small><%= hackathon.title %></small></p>
<p><a href="/hack-events/hackathons">← Back to Listings</a></p>

<p>
  <strong>Total teams registered:</strong> <%= registrations.length %>
  &nbsp;|&nbsp;
  <strong>Team size range:</strong> <%= hackathon.teamSizeMin %>–<%= hackathon.teamSizeMax %>
</p>

<% if (registrations.length === 0) { %>
  <p><em>No registrations yet.</em></p>
<% } else { %>

  <table border="1" cellpadding="6" cellspacing="0">
    <thead>
      <tr>
        <th>#</th>
        <th>Team Leader</th>
        <th>Team Size</th>
        <th>Member User IDs</th>
        <th>Member Emails</th>
        <th>Registered At</th>
      </tr>
    </thead>
    <tbody>
      <% registrations.forEach((r, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= r.username %></td>
          <td><%= r.teamSize %></td>

          <!-- All User IDs — leader first, then teammates -->
          <td>
            <ul style="margin:0; padding-left:16px;">
              <li><%= r.userId %> (leader)</li>
              <% (r.teamMembers || []).forEach(m => { %>
                <li><%= m.userId %></li>
              <% }) %>
            </ul>
          </td>

          <!-- All Emails — leader first, then teammates -->
          <td>
            <ul style="margin:0; padding-left:16px;">
              <li><%= r.email %> (leader)</li>
              <% (r.teamMembers || []).forEach(m => { %>
                <li><%= m.email %></li>
              <% }) %>
            </ul>
          </td>

          <td><%= r.registeredAt.toLocaleDateString('en-GB') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

<% } %>

</body>
</html>

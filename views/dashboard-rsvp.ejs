<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>RSVP Detail</title>
</head>
<body>

  <a href="/dashboard">← Back to dashboard</a>
  <h1><%= event.title %></h1>
  <p>by <%= event.organizer %></p>

  <table border="0" cellpadding="4">
    <% if (event.startDate) { %>
      <tr><td><strong>Date</strong></td><td><%= new Date(event.startDate).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'long', year: 'numeric' }) %></td></tr>
    <% } %>
    <% if (event.location) { %>
      <tr><td><strong>Location</strong></td><td><%= event.location %></td></tr>
    <% } %>
    <tr><td><strong>Status</strong></td><td><%= rsvp.status %></td></tr>
    <tr><td><strong>Joined</strong></td><td><%= new Date(rsvp.joinedAt).toLocaleDateString('en-SG', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'short', year: 'numeric' }) %></td></tr>
  </table>

  <hr/>

  <!-- UPDATE NOTE -->
  <h3>My Note</h3>
  <form method="POST" action="/rsvp-update">
    <textarea name="note" rows="4" cols="50"><%= rsvp.note || '' %></textarea>
    <input type="hidden" name="rsvpId" value="<%=rsvp._id%>">
    <br/>
    <button type="submit">Save Note</button>
  </form>

  <hr/>

  <!-- DELETE -->
  <h3>Cancel RSVP</h3>
  <p>This will remove this event from your calendar.</p>
  <form method="POST" action="/rsvp-delete">
    <input type="hidden" name="rsvpId" value="<%=rsvp._id%>">
    <button type="submit" onclick="return confirm('Are you sure you want to cancel this RSVP?')">
      Cancel RSVP
    </button>
  </form>

</body>
</html>
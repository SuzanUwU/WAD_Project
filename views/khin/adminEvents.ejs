<!DOCTYPE html>
<html>
<head>
<title>Admin Events</title>
</head>

<body>

<h1>Admin Events</h1>

<a href="/events/ccaAdmin/create">
  <button>Create a new event</button>
</a>

<br><br>

<table border="1" cellpadding="15" width="80%">

<tr>
  <th>Image</th>
  <th>Details</th>
  <th>Actions</th>
</tr>

<% events.forEach(event => { %>

<tr>

  <!-- Image -->
  <td>
    <% if (event.image && event.image.data) { %>
      <img 
        src="data:<%= event.image.contentType %>;base64,<%= event.image.data.toString('base64') %>" 
        width="150"
      >
    <% } %>
  </td>

  <!-- Details -->
  <td>
    <b><%= event.title %></b><br><br>

    Date: <%= event.date %><br>
    Location: <%= event.location %><br>
    Category: <%= event.category %><br>
    Club Type: <%= event.clubType %>
  </td>

  <!-- Actions -->
  <td>

  <a href="/events/ccaAdmin/<%= event._id %>/edit">
    <button>Edit</button>
  </a>

  <form action="/events/ccaAdmin/delete/<%= event._id %>" method="POST" style="display:inline;">
    <button onclick="return confirm('Delete this event?')">Delete</button>
  </form>

  <a href="/events/ccaAdmin/<%= event._id %>/attendees">
    <button>View Attendees</button>
  </a>

</td>

</tr>

<% }) %>

</table>

</body>
</html>
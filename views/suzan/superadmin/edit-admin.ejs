<!DOCTYPE html>
<html>
<head>
  <title>Edit Admin</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; }
    .form-group { margin-bottom: 20px; }
    label { display: block; margin-bottom: 5px; font-weight: bold; }
    input[type="text"], input[type="email"], input[type="password"], select { 
      width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; 
    }
    input[readonly] { background-color: #f5f5f5; }
    button { background: #28a745; color: white; padding: 12px 24px; border: none; border-radius: 4px; cursor: pointer; }
    button:hover { background: #218838; }
    .success { color: green; background: #d4edda; padding: 15px; margin: 20px 0; border-radius: 5px; border: 1px solid #c3e6cb; }
    .error { color: red; background: #f8d7da; padding: 15px; margin: 20px 0; border-radius: 5px; border: 1px solid #f5c6cb; }
    .back-link { display: inline-block; margin-top: 20px; color: #007bff; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <% if (success) { %>
    <div class="success">✅ Admin updated successfully!</div>
  <% } %>
  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="error">
      <% errors.forEach(error => { %>
        <p><%= error.msg %></p>
      <% }) %>
    </div>
  <% } %>

  <h1>Edit Admin: <%= admin.username %></h1>

  <form action="/superadmin/admins-settings/edit/<%= admin._id %>" method="POST">
    <!-- Hidden ID for update -->
    <input type="hidden" name="_id" value="<%= admin._id %>">

    <!-- Non-editable Admin ID -->
    <div class="form-group">
      <label for="userId">Admin ID:</label>
      <input type="text" id="userId" value="<%= admin.userId %>" readonly>
    </div>

    <!-- Username -->
    <div class="form-group">
      <label for="username">Username:</label>
      <input type="text" id="username" name="username" value="<%= admin.username %>" required>
    </div>

    <!-- Email -->
    <div class="form-group">
      <label for="email">Email:</label>
      <input type="email" id="email" name="email" value="<%= admin.email %>" required>
    </div>

    <!-- Admin Type (sub-admin role) -->
    <div class="form-group">
      <label for="admin_type">Admin Type:</label>
      <select id="admin_type" name="admin_type" required>
        <option value="cca-admin" <%= admin.admin_type === 'cca-admin' ? 'selected' : '' %>>CCA Admin</option>
        <option value="hack-admin" <%= admin.admin_type === 'hack-admin' ? 'selected' : '' %>>Hackathon Admin</option>
        <option value="ptjob-admin" <%= admin.admin_type === 'ptjob-admin' ? 'selected' : '' %>>PT Job Admin</option>
        <option value="career-admin" <%= admin.admin_type === 'career-admin' ? 'selected' : '' %>>Career Admin</option>
      </select>
    </div>

    <button type="submit">Update Admin</button>
    <a href="/superadmin/admins-settings" class="back-link">← Back to Admin Settings</a>
  </form>
</body>
</html>

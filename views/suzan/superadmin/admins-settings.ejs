<!DOCTYPE html>
<html>
<head>
  <title>🔥 Super Admin - Admin Settings</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 1200px; margin: 50px auto; padding: 20px; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
    th { background: #f8f9fa; font-weight: bold; }
    .btn { padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; margin: 2px; }
    .btn-edit { background: #2196F3; color: white; }
    .btn-delete { background: #f44336; color: white; }
    .btn-create { background: #4CAF50; color: white; padding: 12px 24px; font-size: 16px; }
    .success { color: #2e7d32; background: #e8f5e8; padding: 12px; border-radius: 4px; margin: 20px 0; }
    .warning { background: #fff3cd; padding: 12px; border-radius: 4px; margin: 20px 0; }
  </style>
</head>
<body>
  <h1>🔥 Super Admin Dashboard - Admin Management</h1>
  
  <div class="warning">
    <strong>Total Admins: <%= admins.length %></strong> | 
    <a href="/superadmin/create-admin" class="btn btn-create">Create New Admin</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>Admin ID</th>
        <th>Admin Name</th>
        <th>Email</th>
        <th>Scope</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% admins.forEach(admin => { %>
        <tr>
          <td><strong><%= admin.userId %></strong></td>
          <td><%= admin.username %></td>
          <td><%= admin.email %></td>

          <td>
            <span style="background: #e3f2fd; padding: 4px 8px; border-radius: 12px; font-size: 12px;">
              <%= admin.admin_type || admin.scope || '-' %>
            </span>
          </td>

          <td>
            <%= admin.createdAt ? new Date(admin.createdAt).toLocaleDateString() : '-' %>
          </td>

          <td>
            <a href="/superadmin/admins-settings/edit/<%= admin._id %>" class="btn btn-edit">✏️ Edit</a>

            <form action="/superadmin/admins-settings/delete/<%= admin._id %>" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-delete" onclick="return confirm('Delete this admin?')">
                🗑️ Delete
              </button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <p><a href="/all-events">← Back to Events</a></p>
</body>
</html>

